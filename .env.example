# Copy to .env (never committed) or set these in your shell.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Your Metal testnet endpoint, https://rpc-testnet.metalntwx.com/v1/<id>. It is a credential: never share or log it.
METAL_RPC_URL=
METAL_ENDPOINT_SECRET=
# Optional. Without it the demo uses deterministic parsers for the canned documents.
KIT11_ANTHROPIC_API_KEY=
# Where the owner key, mandate keys and credentials live. Outside this repo.
KIT11_KEYS_DIR=
# Optional, Phase D: Max's hub and Cardputer. Both switches off by default. The hub's address and token are
# credentials: never share or log them.
HUB_PUSH_ENABLED=
HUB_DECISIONS_ENABLED=
HUB_URL=
HUB_PUSH_TOKEN=
