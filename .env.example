# Copy to .env (never committed) or set these in your shell.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Your Metal testnet endpoint, https://rpc-testnet.metalntwx.com/v1/<id>. It is a credential: never share or log it.
METAL_RPC_URL=
METAL_ENDPOINT_SECRET=
# Optional. Without it the demo uses deterministic parsers for the canned documents.
KIT11_ANTHROPIC_API_KEY=
# Where the owner key, mandate keys and credentials live. Outside this repo.
KIT11_KEYS_DIR=
# Optional: send approvals to an outside device of the owner's (a hub). Both switches off by default. The hub's address and token are
# credentials: never share or log them.
HUB_PUSH_ENABLED=
HUB_DECISIONS_ENABLED=
HUB_URL=
HUB_PUSH_TOKEN=
# Optional: post the books to T:0 after each money action (never blocks a payment). T0_API_KEY is a
# credential. T0_RATES: units of T:0's functional currency per unit, e.g. USD=0.92; T0_MAP=sandbox for the shared sandbox.
T0_ENABLED=
T0_API_KEY=
T0_RATES=
T0_MAP=
