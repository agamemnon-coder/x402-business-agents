// Purser Cloud: the multi-tenant API (docs/cloud.md). The database_id, RP_ID and ORIGIN below are placeholders: before
// a deploy from this file, create the stores (EU) and set the secrets; see docs/cloud.md. Never put a secret in this file.
{
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "purser-cloud",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    // wrangler d1 create purser-cloud --location weur  → paste its database_id here.
    { "binding": "DB", "database_name": "purser-cloud", "database_id": "SET-AFTER-wrangler-d1-create", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    // wrangler r2 bucket create purser-cloud-docs --jurisdiction eu
    { "binding": "DOCS", "bucket_name": "purser-cloud-docs", "jurisdiction": "eu" }
  ],
  "vars": {
    // The cloud's own address: passkeys are bound to it.
    "RP_ID": "cloud.example.invalid",
    "ORIGIN": "https://cloud.example.invalid"
    // MAIL_DOMAIN: set once a domain's Email Routing sends <slug>@<domain> to this Worker.
  },
  // pdf.js for the console's invoice view, served through the Worker (run_worker_first: every request meets the Worker's
  // own headers and only /assets/pdfjs.mjs is ever read from here). npm run cloud:pdfjs fills cloud/public before a deploy.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Daily: purge closed companies past their 7-year retention; clear spent challenges and old rate windows.
  "triggers": { "crons": ["17 3 * * *"] },
  "env": {
    // The read-only demo of seeded test companies (docs/cloud-demo.md): a Worker of its own with its own database and
    // bucket, which hold the seed and nothing else. Every wrangler command for it takes --env demo. No secret, no mail
    // domain and no cron: demo mode signs nobody in, takes no mail and writes nothing (cloud/src/demo.ts).
    "demo": {
      "name": "purser-demo",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        // wrangler d1 create purser-demo  → paste its database_id here.
        { "binding": "DB", "database_name": "purser-demo", "database_id": "SET-AFTER-wrangler-d1-create-purser-demo", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        // wrangler r2 bucket create purser-demo-docs
        { "binding": "DOCS", "bucket_name": "purser-demo-docs" }
      ],
      "vars": {
        "DEMO_PUBLIC": "on",
        // The seeded companies, in the order the console shows them (npm run cloud:seed-demo prints the same list).
        "DEMO_SLUGS": "northwind-outdoor,bakery-de-test,fietslab-bike-workshop",
        // Its workers.dev address: the console's page is built for it.
        "RP_ID": "purser-demo.max-31b.workers.dev",
        "ORIGIN": "https://purser-demo.max-31b.workers.dev"
      },
      // The static assets (pdf.js) are the same as above: wrangler hands "assets" down to an environment.
      "triggers": { "crons": [] }
    }
  }
}
