// purser-try: a deployment of its own for the company engine on test money (a stand-in bank; no payment reaches a real
// bank). It is never the product's deployment (purser-cloud, cloud/wrangler.jsonc), and never its stores.
// It is cloud/wrangler.jsonc with only these changed: the name, the workers.dev address (RP_ID, ORIGIN), its own D1
// database, ENGINE_MODE "test_money", the capabilities HANDS_ON and ENGINE_CLAUDE (switches decide at run time; a
// missing switch is off), an hourly cron, and no R2: the DOCS binding is left out, so documents and the archive are
// kept in D1 (cloud/src/blobsSql.ts, sqlBlobs). test/cloud-try-config.test.ts holds the two files to that.
// Deploy it only as purser-try, never pointed at an existing Worker: a Durable Object class and its migration cannot be
// rolled back past their first deploy, so the migration list stays as it is. No secret goes in this file:
// SESSION_SECRET, ADMIN_TOKEN_SHA256 and the demo's capped Claude key are set with wrangler secret put. No mail domain,
// no real data.
{
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "purser-try",
  // The Worker and the class of the company engines' Durable Object.
  "main": "src/entry.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    // wrangler d1 create purser-try --location weur  → paste its database_id here.
    { "binding": "DB", "database_name": "purser-try", "database_id": "3c45b5df-a535-475a-a21c-b90e558702a1", "migrations_dir": "migrations" }
  ],
  // No R2 bucket: without the DOCS binding the Worker keeps documents and the archive in D1 (cloud/src/blobsSql.ts).
  "vars": {
    // The deployment's own address: passkeys are bound to it.
    "RP_ID": "purser-try.max-31b.workers.dev",
    "ORIGIN": "https://purser-try.max-31b.workers.dev",
    // The /v1/engine routes on: the engine pays on a stand-in bank, test money only.
    "ENGINE_MODE": "test_money",
    // Capabilities only: the visitors' companies (HANDS_ON) and Claude in the engine (ENGINE_CLAUDE) are on at run time
    // only where their switches say so; a missing switch is off.
    "HANDS_ON": "on",
    "ENGINE_CLAUDE": "on"
  },
  // The engine: one Durable Object per company (cloud/src/engine/object.ts), on its own SQLite. A class is SQLite-backed
  // only from its first deploy, and a deploy with a migration cannot be rolled back past it.
  "durable_objects": { "bindings": [{ "name": "ENGINE", "class_name": "CompanyEngine" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CompanyEngine"] }],
  // The engine's modules read import.meta.url, dirname and filename when they load; a Worker's bundle has none.
  "define": { "import.meta.url": "\"file:///purser-cloud/worker.js\"", "import.meta.dirname": "\"/purser-cloud\"", "import.meta.filename": "\"/purser-cloud/worker.js\"" },
  // Packages the engine's import graph names and no Worker can carry: swapped for a file that throws when used.
  "alias": { "playwright": "./src/engine/stub.ts", "better-sqlite3": "./src/engine/stub.ts" },
  // The engine's schema (src/db/schema.sql, src/db/ledger.sql) as text modules.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // pdf.js for the console's invoice view, served through the Worker (run_worker_first: every request meets the Worker's
  // own headers and only /assets/pdfjs.mjs is ever read from here). npm run cloud:pdfjs fills cloud/public before a deploy.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Hourly: the sweep of the visitors' companies, and the cloud's own job (purge closed companies past their 7-year
  // retention; clear spent challenges and old rate windows), which is safe to run every hour; and the nightly autopilot
  // (cloud/src/edge/autopilot.ts) on its first firing each UTC day: each company's engine synced, its digest written.
  "triggers": { "crons": ["17 * * * *"] }
  // AUTOPILOT=off or STATS=off (a var) switches the nightly autopilot or the daily counters off; both are on unset.
  //
  // Inbound e-mail filed into the company's engine through a Cloudflare Queue (cloud/src/edge/inbox.ts). Off until a
  // mail domain routes here (MAIL_DOMAIN) and the queues exist: a deploy that binds a queue that was not created fails.
  // To switch it on: npx wrangler queues create purser-try-inbox && npx wrangler queues create purser-try-inbox-dlq, then
  // put this block in the configuration (as a key of the object above):
  //   "queues": {
  //     "producers": [{ "queue": "purser-try-inbox", "binding": "INBOX_QUEUE" }],
  //     "consumers": [{ "queue": "purser-try-inbox", "max_batch_size": 5, "max_batch_timeout": 5, "max_retries": 8, "dead_letter_queue": "purser-try-inbox-dlq" }]
  //   }
}
